# ========================
# 悦读成语 Next.js 14 环境变量模板
# 使用方法: cp .env.example .env.local
# ========================

# ---- Supabase ----
# 获取路径: Supabase Dashboard → Settings → API
# Project URL，格式: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 匿名公钥 (anon public key)，安全暴露给浏览器
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 服务端密钥 (service_role key)，仅用于 API Route / 服务端特权操作
# ⚠️ 切勿暴露给前端，切勿提交到 Git
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 站点地址 ----
# 生产部署后: https://joyofidioms.com
NEXT_PUBLIC_SITE_URL=https://joyofidioms.com

# ---- Lemon Squeezy 托管结账 ----
# 全站支付入口统一跳转的 LS 官方托管结账页地址
# 获取路径: Lemon Squeezy Dashboard → Products → 结账链接（Checkout link / Buy link）
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://joyofidioms.lemonsqueezy.com/buy

# ---- 邮件通知（后续阶段）----
# RESEND_API_KEY=re_xxx
# CONTACT_NOTIFY_EMAIL=support@joyofidioms.com
