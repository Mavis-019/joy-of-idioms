# ========================
# 悦读成语 Next.js 14 环境变量模板
# 使用方法: cp .env.example .env.local
# ========================

# ---- Supabase ----
# 获取路径: Supabase Dashboard → Settings → API
# Project URL，格式: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 匿名公钥 (anon public key)，安全暴露给浏览器
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 服务端密钥 (service_role key)，仅用于 API Route / 服务端特权操作
# /api/webhook 写入 course_access 表时需要此密钥
# ⚠️ 切勿暴露给前端，切勿提交到 Git
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 站点地址 ----
# 生产部署后: https://joyofidioms.com
NEXT_PUBLIC_SITE_URL=https://joyofidioms.com

# ---- Paddle 结账（MoR 商家记录模式，overlay 弹窗结账）----
# 客户端 token（NEXT_PUBLIC_ 前缀，会暴露给浏览器，仅用于唤起结账弹窗）
# 沙盒环境 token 以 test_ 开头；上线时替换为正式 live_ 开头的 token
# 获取路径: Paddle Dashboard → Developer tools → Authentication → Client-side tokens
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxx

# ---- Paddle Webhook（⚠️ 仅服务端使用，严禁暴露到前端）----
# API key（沙盒环境以 pdl_sdbx_ 开头，正式环境以 pdl_live_ 开头）
# 获取路径: Paddle Dashboard → Developer tools → Authentication → API keys
PADDLE_API_KEY=pdl_sdbx_xxxxxxxxxxxxxxxx

# Webhook 签名密钥（用于 /api/webhook 校验 Paddle-Signature 请求头）
# 获取路径: Paddle Dashboard → Developer tools → Notifications → Webhook destinations
PADDLE_WEBHOOK_SECRET=pdl_ntf_xxxxxxxxxxxxxxxx

# ---- 邮件通知（后续阶段）----
# RESEND_API_KEY=re_xxx
# CONTACT_NOTIFY_EMAIL=support@joyofidioms.com
