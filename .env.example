# ========================
# 悦读成语 Next.js 14 环境变量模板
# 使用方法: cp .env.example .env.local
# ========================

# ---- Supabase ----
# 获取路径: Supabase Dashboard → Settings → API
# Project URL，格式: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 匿名公钥 (anon public key)，安全暴露给浏览器
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 服务端密钥 (service_role key)，仅用于 API Route / 服务端特权操作
# ⚠️ 切勿暴露给前端，切勿提交到 Git
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 站点地址 ----
# 本地开发: http://localhost:3000
# Vercel 部署后: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe 支付（后续阶段）----
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- 邮件通知（后续阶段）----
# RESEND_API_KEY=re_xxx
# CONTACT_NOTIFY_EMAIL=contact@moyuchengyu.com
